# e-Aduan v3 — Environment Configuration Template
# Salin fail ini sebagai .env dan isi nilai sebenar.
# JANGAN letak credentials sebenar dalam fail ini.

# ── Database ──────────────────────────────────────
DB_HOST=10.0.36.97
DB_DATABASE=FMSDEV
DB_USER=
DB_PASSWORD=

# ── Authentication ────────────────────────────────
# auth_mode: 'portal_warga' (production) atau 'google' (dev/test)
AUTH_MODE=portal_warga
JWT_SECRET=
JWT_ALGORITHM=HS512
PORTAL_URL=https://portal.uitm.edu.my/login

# ── Google OAuth 2.0 ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev:  https://fmsdev.uitm.edu.my/ea_newv3/auth/google_callback.php
# Prod: https://fms.uitm.edu.my/ea_newv3/auth/google_callback.php
GOOGLE_REDIRECT_URI=

# ── Base URL (tanpa trailing slash) ───────────────
# Dev:  https://fmsdev.uitm.edu.my/ea_newv3
# Prod: https://fms.uitm.edu.my/ea_newv3
BASE_URL=
